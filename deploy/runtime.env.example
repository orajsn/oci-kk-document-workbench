# Install as /etc/kk-pilot/runtime.env, root:root, mode 0600.
# systemd reads this file before changing to kkpilot; do not source untrusted files.
# Supply actual secret values outside source, cloud-init and Terraform state.
KK_CLOUD_DB_PASSWORD=REPLACE_OUTSIDE_SOURCE
KK_CLOUD_DB_WALLET_DIR=/etc/kk-pilot/wallet
KK_CLOUD_DB_WALLET_PASSWORD=REPLACE_OUTSIDE_SOURCE
KK_CLOUD_REVIEWER_IDENTITY=REPLACE_WITH_OPERATOR

KK_OCI_COMPARTMENT_OCID=
KK_OCI_ROUTING_PROFILE_OCID=
